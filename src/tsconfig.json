{
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"DOM",
			"ES2021"
		],
		"strict": false,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"wwwroot/**/*.ts"
	],
	"exclude": [
		"wwwroot/app.js",
		"wwwroot/app.js.map",
		"node_modules"
	]
}
