{
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"lib": [
			"DOM",
			"ES2021"
		],
		"strict": false,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["wwwroot/**/*.ts", "wwwroot/**/*.tsx"],
	"exclude": [
		"wwwroot/app.js",
		"wwwroot/app.js.map",
		"node_modules"
	]
}
