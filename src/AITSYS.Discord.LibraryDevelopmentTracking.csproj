<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>DV2001;CS8618;CA1822</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DisCatSharp.Analyzer" Version="1.0.6.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="ScottPlot" Version="5.1.59" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.0" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />
		<PackageReference Include="DisCatSharp" Version="10.7.1-nightly-032" />
		<PackageReference Include="DisCatSharp.ApplicationCommands" Version="10.7.1-nightly-032" />
		<PackageReference Include="DisCatSharp.Common" Version="10.7.1-nightly-032" />
		<PackageReference Include="DisCatSharp.Interactivity" Version="10.7.1-nightly-032" />
		<PackageReference Include="System.Net.Security" Version="4.3.2" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.89.0" />
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<None Update="config.example.json">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="config.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="CopyFilesAfterPublish" AfterTargets="AfterPublish">
		<Copy SourceFiles="$(TargetDir)runtimes/linux-x64/native/libSkiaSharp.so" DestinationFolder="$([System.IO.Path]::GetFullPath('$(PublishDir)'))/bin/" />
		<Copy SourceFiles="$(TargetDir)runtimes/linux-x64/native/libHarfBuzzSharp.so" DestinationFolder="$([System.IO.Path]::GetFullPath('$(PublishDir)'))/bin/" />
	</Target>
</Project>
